library(Seurat) # allows read10x file to be read and visualised
library(clusterProfiler) # Generate cluster graph of similar genes/cells
library("org.Mm.eg.db") # mouse database for suerat/ read10x funcitons
library(dplyr) # adding grammar for more complex functions suchas i j logs etc

#reading of cell ranger file, was adjusted for different brain regions  \\Cortex_Cellranger\\ -- \\Cerebell_Cellragner\\ 
counts <- Read10X(data.dir = ("C:\\Users\\User\\Documents\\Temp_Directory\\CellRanger_Out\\RTN_Cellranger\\filtered_feature_bc_matrix")) 

#create an object from the cell ranger file to be manipulated here
seurat_object <- CreateSeuratObject(counts = counts)


# Normalize the data
seurat_object <- NormalizeData(seurat_object)

# Find variable features
seurat_object <- FindVariableFeatures(seurat_object)

# Scale the data to ensure high expression level gene don't over influence clustering
seurat_object <- ScaleData(seurat_object)

# Perform PCA to simplfy data while retaining important information
seurat_object <- RunPCA(seurat_object)

# Find neighbors and clusters
seurat_object <- FindNeighbors(seurat_object)
seurat_object <- FindClusters(seurat_object, resolution = 0.5) # Resolution can be adjusted to more or less clustering

# Run UMAP for visualization
seurat_object <- RunUMAP(seurat_object, dims = 1:10)


# Plot the UMAP
DimPlot(seurat_object, reduction = "umap", label = TRUE)


# feature plot of common astrocyte markers, same for 3 datasets 

FeaturePlot(seurat_object, features = c("Aqp4",
                                        "Gfap",
                                        "Sox9",
                                        "Slc1a3",
                                        "Slc1a2",
                                        "Atp1a2",
                                        "Gja1",
                                        "Slc6a11",
                                        "Islr",
                                        "Gdf10",
                                        "S100b",
                                        "Aldh1l1"))

# feature plot of top log2fc genes, altered for accordingly for each dataset

FeaturePlot(seurat_object, features = c("Paqr6",
