#Markers that are differentialy expressed between listed cluster, altered accordingly for each dataset, and filtered to show significant markers
cluster3_vs_4 <- FindMarkers(seurat_object, ident.1 = 3, ident.2 = 4)
head(cluster3_vs_4)
significant_markers <- cluster3_vs_4[cluster3_vs_4$p_val_adj < 0.05 & abs(cluster3_vs_4$avg_log2FC) > 0.25, ]
head(significant_markers)

# violin and feature plot for significant markers adjusted accordingly for each data set 
VlnPlot(seurat_object, features = c("mt-Atp6", "mt-Co3", "Cd81", "Htra1", "Slc7a10", "Atp1b2"), group.by = "seurat_clusters")
FeaturePlot(seurat_object, features = c("mt-Atp6", "mt-Co3", "Cd81", "Htra1", "Slc7a10", "Atp1b2"))

# markers that are differentialy expressed  in each cluster listed, adjusted accordingly for each dataset
Cluster3 <- FindMarkers(seurat_object, ident.1 = 3)
head(Cluster3)
cluster4 <- FindMarkers(seurat_object, ident.1 = 4)
head(cluster4)


#Enriched pathway for compared cluster compared to mouse database, adjusted accordingly for each dataset 

gene_list <- rownames(cluster3_vs_4)
enriched_pathways <- enrichGO(gene = gene_list,
                              OrgDb = org.Mm.eg.db,
                              keyType = "SYMBOL",
                              ont = "BP")

#graphs displaying enriched pathway, where first cluster listed is compared to second list listed 3 compared 4 not the other way around.
dotplot(enriched_pathways)
barplot(enriched_pathways, showCategory = 30)

# scripts to identify top markers across all cluster and can be adjusted for either top 4, top 10 etc (computationally intensive)
cluster_ids <- unique(seurat_object$seurat_clusters)
marker_genes <- list()
for (i in cluster_ids) {
  markers <- FindMarkers(seurat_object, ident.1 = i)
  top_markers <- markers %>% top_n(4, wt = avg_log2FC)
  marker_genes[[paste("cluster", i)]] <- top_markers
}
marker_genes








